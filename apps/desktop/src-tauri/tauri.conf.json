{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quotio",
  "version": "0.1.0",
  "identifier": "dev.quotio.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quotio",
        "width": 1160,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Trong Nguyen",
    "copyright": "Copyright (c) 2025 Trong Nguyen",
    "license": "MIT",
    "homepage": "https://github.com/nguyenphutrong/quotio",
    "category": "Utility",
    "shortDescription": "Track AI coding assistant quotas",
    "longDescription": "Quotio shows quota and usage for your AI coding assistant accounts in a window and the system tray.",
    "externalBin": ["binaries/quotio"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libdbus-1-3"],
        "recommends": ["gnome-keyring | kwallet6"]
      },
      "rpm": {
        "depends": ["dbus-libs"]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
